# Sentinel RAG Ops - local development
# Copy to .env and replace the placeholders. Never commit .env.

# Server
HOST=127.0.0.1
PORT=9621
WEBUI_TITLE='Sentry RAG Ops'
WEBUI_DESCRIPTION='Knowledge ingestion, graph exploration, and retrieval operations'
ENABLE_API_DOCS=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WORKSPACE=sentinel_rag_ops
WORKING_DIR=./data/rag_storage
INPUT_DIR=./data/inputs
PROMPT_DIR=./data/prompts

# API protection
LIGHTRAG_API_KEY=REPLACE_WITH_A_LONG_RANDOM_API_KEY

# One Google Gemini credential is shared by generation and embeddings.
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
LLM_BINDING=gemini
LLM_BINDING_HOST=DEFAULT_GEMINI_ENDPOINT
LLM_MODEL=gemini-3.1-flash-lite
MAX_ASYNC_LLM=1
EMBEDDING_BINDING=gemini
EMBEDDING_BINDING_HOST=DEFAULT_GEMINI_ENDPOINT
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
RERANK_BINDING=null

# Local storage
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
SUPABASE_STORAGE_ENABLED=false

# Processing
LIGHTRAG_PARSER=*:legacy-R
MAX_PARALLEL_INSERT=1
ENABLE_LLM_CACHE=false