# Sentinel RAG Ops configuration. Copy to .env and replace placeholders.

# Server
HOST=127.0.0.1
PORT=9621
WEBUI_TITLE='Sentinel RAG Ops'
WEBUI_DESCRIPTION='Knowledge ingestion, graph exploration, and retrieval operations'
ENABLE_API_DOCS=true
WORKING_DIR=./data/rag_storage
INPUT_DIR=./data/inputs
PROMPT_DIR=./data/prompts

# Security: set at least one authentication mode before public deployment.
LIGHTRAG_API_KEY=REPLACE_WITH_A_LONG_RANDOM_API_KEY
# AUTH_ACCOUNTS='admin:REPLACE_WITH_BCRYPT_PASSWORD_HASH'
# TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_TOKEN_SECRET

# Generation provider (OpenAI-compatible starter configuration)
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=REPLACE_WITH_LLM_API_KEY
LLM_MODEL=gpt-5.4-mini
MAX_ASYNC_LLM=4

# Embedding provider
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=REPLACE_WITH_EMBEDDING_API_KEY
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

# Optional reranker
RERANK_BINDING=null
# RERANK_MODEL=REPLACE_WITH_RERANK_MODEL
# RERANK_BINDING_HOST=REPLACE_WITH_RERANK_ENDPOINT
# RERANK_BINDING_API_KEY=REPLACE_WITH_RERANK_API_KEY

# Local storage defaults. Replace these class names and add provider-specific
# database variables when using PostgreSQL, Neo4j, Redis, Qdrant, or another backend.
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

# Processing and retrieval
LIGHTRAG_PARSER=*:native-teP,*:legacy-R
MAX_PARALLEL_INSERT=3
ENABLE_LLM_CACHE=false
# COSINE_THRESHOLD=0.2
# TOP_K=40
# CHUNK_TOP_K=20

# Gemini alternative
# LLM_BINDING=gemini
# LLM_BINDING_API_KEY=REPLACE_WITH_GEMINI_API_KEY
# LLM_MODEL=gemini-3.1-flash-lite
# EMBEDDING_BINDING=gemini
# EMBEDDING_BINDING_API_KEY=REPLACE_WITH_GEMINI_API_KEY
# EMBEDDING_MODEL=text-embedding-004
# EMBEDDING_DIM=768

# Ollama alternative
# LLM_BINDING=ollama
# LLM_BINDING_HOST=http://127.0.0.1:11434
# LLM_MODEL=qwen2.5:7b
# EMBEDDING_BINDING=ollama
# EMBEDDING_BINDING_HOST=http://127.0.0.1:11434
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768
