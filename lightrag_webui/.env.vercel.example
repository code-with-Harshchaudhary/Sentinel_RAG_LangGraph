# Public browser-visible backend address. This is not a secret.
VITE_BACKEND_URL=https://api.example.com

# Public browser-visible Supabase credentials (for Vercel Project Settings > Environment Variables).
# Never add the service-role key or database password to Vercel.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

