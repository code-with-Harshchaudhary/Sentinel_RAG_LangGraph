# Sentinel RAG Ops - Render backend with Supabase
# Add these values in Render's Environment page. Never commit real secrets.

# Server and browser origin
HOST=0.0.0.0
PORT=9621
WEBUI_TITLE='Sentinel RAG Ops'
ENABLE_API_DOCS=false
CORS_ORIGINS=https://YOUR_VERCEL_PROJECT.vercel.app
LIGHTRAG_API_KEY=REPLACE_WITH_A_LONG_RANDOM_API_KEY
WORKSPACE=sentinel_rag_ops
WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs
PROMPT_DIR=/app/data/prompts

# Gemini generation and embeddings
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
LLM_BINDING=gemini
LLM_BINDING_HOST=DEFAULT_GEMINI_ENDPOINT
LLM_MODEL=gemini-3.1-flash-lite
MAX_ASYNC_LLM=1
EMBEDDING_BINDING=gemini
EMBEDDING_BINDING_HOST=DEFAULT_GEMINI_ENDPOINT
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
RERANK_BINDING=null

# Supabase Shared Pooler, Session mode, port 5432
POSTGRES_HOST=aws-0-YOUR-REGION.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.YOUR_PROJECT_REF
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
POSTGRES_DATABASE=postgres
POSTGRES_SSL_MODE=require
POSTGRES_MAX_CONNECTIONS=5
POSTGRES_VECTOR_INDEX_TYPE=HNSW

# Store structured RAG state in Supabase PostgreSQL.
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE=PGTableGraphStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage

# Store original uploads in a private Supabase Storage bucket.
# The service-role key belongs only on Render; never expose it to Vercel.
SUPABASE_STORAGE_ENABLED=true
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=sentinel-documents
SUPABASE_STORAGE_PREFIX=documents
SUPABASE_STORAGE_TIMEOUT=60

# Conservative values for Render Free's 512 MB instance.
LIGHTRAG_PARSER=*:legacy-R
MAX_PARALLEL_INSERT=1
ENABLE_LLM_CACHE=false